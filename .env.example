# Copy to .env and fill in. NEVER commit the real .env.

# ---- Cloudflare Turnstile ----
# Secret key for the widget. Get it from the Turnstile dashboard
# (Settings -> Secret Key). Site key is public and lives in the frontend.
TURNSTILE_SECRET=

# Set to false ONLY for local development without network access to
# Cloudflare. Any non-production use still fails closed on a bad token.
TURNSTILE_ENABLED=true

# ---- Sessions ----
# Access tokens are short-lived; refresh tokens carry the long session.
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60
SESSION_ABSOLUTE_TTL_DAYS=90

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./egress.db

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
